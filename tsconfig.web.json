{
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "outDir": "./out",
        "types": [
            "vite/client"
        ],
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/renderer/src/*"
            ]
        }
    },
    "include": [
        "src/renderer/src/**/*",
        "src/shared/**/*",
        "src/preload/index.d.ts"
    ]
}
